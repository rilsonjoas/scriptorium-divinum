{
  "info": {
    "description": "API pública para consulta de obras clássicas da teologia cristã",
    "title": "Scriptorium Divinum API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/quotes/daily": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "author",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "affiliateUrl": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "author": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "dominioPublico": {
                      "type": "boolean"
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "scriptoriumUrl": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "source": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "theme": {
                      "type": [
                        "null",
                        "string"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "author",
                    "text",
                    "dominioPublico",
                    "date"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "details": {
                      "additionalProperties": {},
                      "type": "object"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "details": {
                      "additionalProperties": {},
                      "type": "object"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Citação do dia — mesma pra todo o cluster, determinística por data",
        "tags": [
          "citacoes"
        ]
      }
    }
  }
}
