# ============================================================
# Scriptorium Divinum - Backend Server (.env.example)
# Infraestrutura: Self-Hosted PostgreSQL no VPS Hetzner
# ============================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Conexão com o PostgreSQL local/VPS
DATABASE_URL=postgresql://scriptorium:scriptorium_secret@localhost:5432/scriptorium_divinum_db

# Origens e CORS
CORS_ORIGIN=http://localhost:8080
PUBLIC_ORIGIN=https://scriptorium.narniano.com

# Sessão e Autenticação Administrativa (Cookie de Sessão HTTP-Only)
COOKIE_SECRET=scriptorium-dev-secret-change-me-please-min-32-chars
ADMIN_COOKIE_NAME=sd_session
SESSION_TTL_DAYS=30

# Afiliados e Observabilidade
AMAZON_AFFILIATE_TAG=rilson-20
# SENTRY_DSN=https://...

# Credenciais para criação do admin inicial (scripts/create-admin.ts)
# ADMIN_EMAIL=admin@narniano.com
# ADMIN_PASSWORD=senha-forte-admin
